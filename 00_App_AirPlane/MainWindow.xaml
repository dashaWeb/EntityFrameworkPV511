<Window x:Class="_00_App_AirPlane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_00_App_AirPlane"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="showFlights" >Load Flights</Button>
            <Button Click="showAirplanes">Load Airplanes</Button>
            <Button Click="showClients">Load Clients</Button>
        </ToolBar>
        <DataGrid Name="grid"></DataGrid>
    </DockPanel>
</Window>
