<Window x:Class="_03_SportShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_03_SportShopApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" FontStyle="Italic">
            <Button Background="#FFDAD3D3" Foreground="#FF360505"  Width="150" Margin="2" Padding="5" Click="GetProducts">Load All Products</Button>
            <Button Background="#FFDAD3D3" Foreground="#FF360505"  Width="100" Margin="2" Padding="5">Load Product</Button>
        </ToolBar>
        <DataGrid DockPanel.Dock="Top" Name="dataGrid"></DataGrid>
        <Canvas>
            <Border Canvas.Top="5">
                <Border.Child>
                    <TextBox Name="text" Height="20" Width="300" KeyDown="text_KeyDown" />
                </Border.Child>
            </Border>
            <Button FontWeight="Bold" FontSize="14" FontStyle="Italic"  Background="#FFDAD3D3" Foreground="#FF360505"  Width="100" Margin="2" Padding="5" Canvas.Top="30" Click="getSelect">Submit</Button>
        </Canvas>
    </DockPanel>
</Window>
